# ==============================================================================
# CloudBox Production Environment Variables Template (.env.production)
# Copy this file to .env on your EC2 host before running docker-compose up
# ==============================================================================

# Node Environment
NODE_ENV=production

# Server HTTP listening port inside Docker container (default: 5000)
PORT=5000

# Allowed Frontend Origins for CORS & HttpOnly Cookie domain validation (comma-separated if multiple)
CLIENT_URL=https://your-cloudbox-app.vercel.app

# PostgreSQL Connection String (AWS RDS PostgreSQL Instance)
# Note: Ensure EC2 Security Group allows traffic to RDS port 5432
DATABASE_URL=postgresql://cloudbox_user:SecurePassword123!@cloudbox-rds.c123456789.us-east-1.rds.amazonaws.com:5432/cloudbox_db

# Enable SSL mode for PostgreSQL if required by RDS (true/false)
DB_SSL=true

# Redis Connection URL (Service name 'redis' within Docker Compose network)
REDIS_URL=redis://redis:6379

# Cryptographic secret for signing short-lived JWT Access Tokens (15 min)
JWT_ACCESS_SECRET=replace_with_a_long_random_64_character_hex_string_for_access_tokens

# Cryptographic secret for signing long-lived JWT Refresh Tokens (7 days)
JWT_REFRESH_SECRET=replace_with_a_long_random_64_character_hex_string_for_refresh_tokens

# Expiration duration for email OTP verification codes in minutes
OTP_EXPIRY_MINUTES=15

# Soft-deleted Trash retention period in days (Phase 4 node-cron auto-cleanup)
TRASH_RETENTION_DAYS=30

# SMTP / Email Provider Configuration (SendGrid, AWS SES, Mailgun, etc.)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_smtp_password_or_api_key
SMTP_FROM="CloudBox Security" <no-reply@yourdomain.com>

# AWS S3 Storage Configuration
AWS_REGION=us-east-1
S3_BUCKET_NAME=cloudbox-user-files-bucket

# AWS IAM ROLE NOTICE:
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are NOT required on EC2!
# The backend automatically authenticates using the attached EC2 IAM Role
# (cloudbox-ec2-role-new) via AWS Instance Metadata Service (IMDS).
# Leave them unset/omitted unless running outside EC2.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
