# Server HTTP listening port (e.g. 5000)
PORT=5000

# Allowed frontend origin for CORS and cookies (e.g. http://localhost:5173)
CLIENT_URL=http://localhost:5173

# PostgreSQL connection string URL (postgresql://username:password@localhost:5432/cloudbox_db)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cloudbox_db

# Redis connection string URL for OTP storage & refresh token session store (redis://localhost:6379)
REDIS_URL=redis://localhost:6379

# Secret key used for signing short-lived JWT access tokens (15-minute validity)
JWT_ACCESS_SECRET=your_super_secret_access_token_key_change_in_production

# Secret key used for signing long-lived JWT refresh tokens (7-day validity)
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_change_in_production

# Expiration duration for OTP codes in minutes (default 15 minutes)
OTP_EXPIRY_MINUTES=15

# SMTP hostname for sending emails via Nodemailer (e.g. smtp.mailtrap.io or smtp.gmail.com)
SMTP_HOST=smtp.mailtrap.io

# SMTP port number (e.g. 587 or 465 or 2525)
SMTP_PORT=2525

# SMTP authentication username
SMTP_USER=your_smtp_username

# SMTP authentication password
SMTP_PASS=your_smtp_password

# Sender address to display in OTP emails (e.g. CloudBox Security <no-reply@cloudbox.app>)
SMTP_FROM="CloudBox Security" <no-reply@cloudbox.app>

# AWS Region for S3 Object Storage (e.g. us-east-1)
AWS_REGION=us-east-1

# S3 Bucket Name for storing user files
S3_BUCKET_NAME=cloudbox-user-files

# AWS Access Key ID with S3 read/write permissions
AWS_ACCESS_KEY_ID=your_aws_access_key_id

# AWS Secret Access Key corresponding to key ID
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

